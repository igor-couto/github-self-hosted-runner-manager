#!/usr/bin/env bash
# Test-only service supervisor. Runs the real binary as an unprivileged account;
# systemd unit syntax is separately verified with systemd-analyze.
set -euo pipefail
if [[ $* == *runner-room-update.* ]]; then
    update_unit=${*: -1}
    # show places --property/--value after the unit name.
    if [[ $1 == show ]]; then
        printf '/etc/systemd/system/%s\n' "$2"
        exit 0
    fi
    case "$1" in
        enable) touch "/tmp/$update_unit.enabled"; if [[ $* == *--now* ]]; then touch "/tmp/$update_unit.active"; fi ;;
        disable) rm -f "/tmp/$update_unit.enabled" ;;
        is-enabled) test -f "/tmp/$update_unit.enabled" ;;
        start) touch "/tmp/$update_unit.active" ;;
        stop) rm -f "/tmp/$update_unit.active" ;;
        is-active) test -f "/tmp/$update_unit.active" ;;
        *) exit 2 ;;
    esac
    exit
fi
stop_app() {
    if [[ -f /tmp/runner-room.pid ]]; then
        kill "$(cat /tmp/runner-room.pid)" 2>/dev/null || true
        rm -f /tmp/runner-room.pid
        sleep 1
    fi
}
start_app() {
    if [[ -f /tmp/fail-next-start ]]; then rm /tmp/fail-next-start; return 1; fi
    while IFS='=' read -r key value; do
        value=${value#\"}; value=${value%\"}
        export "$key=$value"
    done </etc/runner-room/runner-room.env
    cd /opt/runner-room/current
    install -d -o runner -g runner -m 750 /var/lib/runner-room
    export STATE_DIRECTORY=/var/lib/runner-room
    runuser -u runner -- ./RunnerRoom 9>&- >/tmp/runner-room.log 2>&1 &
    echo "$!" >/tmp/runner-room.pid
}
case "$1" in
    show)
        case "$*" in
            *--property=FragmentPath*) printf '/etc/systemd/system/runner-room.service\n' ;;
            *--property=User*) printf 'runner\n' ;;
            *--property=ActiveState*)
                if [[ -f /tmp/runner-room.pid ]]; then echo active; else echo inactive; fi ;;
            *) printf 'Id=actions.runner.example.api.service\nLoadState=loaded\nActiveState=active\nSubState=running\n\n' ;;
        esac
        ;;
    daemon-reload) : ;;
    enable) touch /tmp/runner-room.enabled ;;
    disable) rm -f /tmp/runner-room.enabled ;;
    is-enabled) test -f /tmp/runner-room.enabled ;;
    is-active) test -f /tmp/runner-room.pid && kill -0 "$(cat /tmp/runner-room.pid)" ;;
    stop) stop_app ;;
    start) start_app ;;
    restart) stop_app; start_app ;;
    *) exit 2 ;;
esac
