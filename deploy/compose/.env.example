# Use the same numeric account as the runner processes (id -u / id -g).
RUNNER_UID=1001
RUNNER_GID=1001
RUNNER_HOSTNAME=home-server
RUNNERS_ROOT=/home/github-runner/actions-runner
# Set your server's LAN address to allow access from other devices.
BIND_ADDRESS=127.0.0.1
PORT=8080
RUNNER_ROOM_IMAGE=runner-room:local
# Set this to the checked-out release version, without the leading v.
APP_VERSION=0.0.0-dev
